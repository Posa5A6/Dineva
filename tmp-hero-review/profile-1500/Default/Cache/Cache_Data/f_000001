}

.cinematic-hero.is-running.is-first-visit .hero-final__brand {
    animation: aperture-final-rise 0.66s 3.04s var(--ease-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .hero-final h1 {
    animation: aperture-final-rise 0.7s 3.18s var(--ease-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .hero-final .hero-kicker,
