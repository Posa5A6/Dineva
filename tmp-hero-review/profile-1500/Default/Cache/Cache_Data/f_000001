@keyframes aperture-seed {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0); }
    65% { opacity: 1; box-shadow: 0 0 0 24px rgba(201, 90, 66, 0.08); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1); box-shadow: 0 0 0 0 rgba(201, 90, 66, 0); }
}

@keyframes aperture-draw { to { stroke-dashoffset: 0; } }

@keyframes aperture-open {
    0% { clip-path: inset(49.8% 49.8% 49.8% 49.8%); }
    38% { clip-path: inset(28% 42% 28% 42%); }
    100% { clip-path: inset(0); }
}

@keyframes aperture-image-settle {
    from { filter: saturate(0.72) brightness(0.72); transform: scale(1.18); }
    to { filter: saturate(0.95) brightness(0.9); transform: scale(1.025); }
}

@keyframes aperture-light {
    0% { left: -42%; opacity: 0; }
    28% { opacity: 0.75; }
    70% { opacity: 0.3; }
    100% { left: 112%; opacity: 0; }
}

@keyframes aperture-word {
    from { opacity: 0; letter-spacing: 0.48em; transform: translate(-50%, 20px); }
    to { opacity: 1; letter-spacing: 0.18em; transform: translate(-50%, 0); }
}

@keyframes aperture-word-leave {
    to { opacity: 0; letter-spacing: 0.3em; transform: translate(-50%, -16px); }
}

@keyframes aperture-meta-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes aperture-meta-out { to { opacity: 0; transform: translateY(-8px); } }

@keyframes aperture-mark-resolve {
    0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    72% { opacity: 1; }
    100% { opacity: 0; transform: translate(calc(-50vw + 60px), calc(-50vh + 45px)) scale(0.13); }
}

@keyframes aperture-cinema-leave { to { visibility: hidden; opacity: 0; } }

@keyframes aperture-final-rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes aperture-service-line { to { transform: scaleX(1); } }

@keyframes settle-header {
    from { opacity: 0.25; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

