.cinematic-hero.is-running.is-first-visit .brand-cinema__word {
    animation: aperture-word 1s 1.72s var(--ease-out) forwards, aperture-word-leave 0.52s 3.04s ease-in forwards;
}

.cinematic-hero.is-running.is-first-visit .brand-cinema__eyebrow,
.cinematic-hero.is-running.is-first-visit .brand-cinema__meta {
    animation: aperture-meta-in 0.5s 0.22s var(--ease-out) both, aperture-meta-out 0.45s 2.95s ease-in forwards;
}

.cinematic-hero.is-running.is-first-visit .brand-mark-stage {
    animation: aperture-mark-resolve 0.82s 2.75s var(--ease-in-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .brand-cinema {
