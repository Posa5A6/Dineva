}

.cinematic-hero.is-running.is-first-visit .brand-mark-stage__seed {
    animation: aperture-seed 0.55s 0.12s var(--ease-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .aperture-mark__stem {
    animation: aperture-draw 0.68s 0.38s var(--ease-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .aperture-mark__bowl {
    animation: aperture-draw 0.92s 0.66s var(--ease-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .aperture-mark__line {
    animation: aperture-draw 0.58s 1.06s var(--ease-in-out) forwards;
}

.cinematic-hero.is-running.is-first-visit .cinematic-scene {
