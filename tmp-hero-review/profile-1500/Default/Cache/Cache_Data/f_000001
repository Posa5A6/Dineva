.no-js .brand-cinema { display: none; }

.js .cinematic-hero:not(.is-resolved)::before { opacity: 1; }

.js .cinematic-hero:not(.is-resolved) .cinematic-scene {
    clip-path: inset(49.8% 49.8% 49.8% 49.8%);
